{
  "name": "@fb-auto/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "next build",
    "build:types": "tsc -b",
    "start": "next start",
    "dev": "next dev",
    "start:custom": "node dist/server.js"
  },
  "dependencies": {
    "@fb-auto/core": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.7.3"
  }
}
