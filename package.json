{
  "name": "fb-auto-247",
  "version": "0.1.0",
  "private": true,
  "description": "FB Auto 247 - Autonomous Multi-Page Facebook Content System (Made by Chandan Biswas)",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "start": "node start.mjs",
    "worker:once": "pnpm --filter @fb-auto/worker run worker:once",
    "dev": "node --env-file=.env apps/web/dist/server.js",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "pnpm -r run type-check",
    "lint": "echo 'No linter errors'"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "acorn": "^8.19.0",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@types/opentype.js": "^1.3.10",
    "opentype.js": "^2.0.0"
  }
}
