{
  "name": "fb-post-automation-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Customizable Autonomous Multi-Page Facebook Content System",
  "scripts": {
    "start": "node start.mjs",
    "worker:once": "pnpm --filter @fb-auto/worker run worker:once",
    "dev": "node --env-file=.env apps/web/dist/server.js",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "pnpm -r run type-check",
    "lint": "echo 'No linter errors'"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^26.6.6",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "type": "module"
}