# Supabase credentials (from supabase.com project settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# AES-256-GCM encryption key for provider keys and Facebook tokens (32 bytes base64)
ENCRYPTION_KEY=

# Facebook Graph API App credentials (from developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# Worker & System Configuration
WORKER_SECRET=local-development-worker-secret
OWNER_EMAIL=owner@example.com
APP_URL=http://localhost:3000
WORKER_LOOP_SECONDS=60
